<Application x:Class="TrafficTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Renk paleti (koyu tema) -->
        <SolidColorBrush x:Key="Bg"        Color="#0F1115"/>
        <SolidColorBrush x:Key="BgPanel"   Color="#171A21"/>
        <SolidColorBrush x:Key="BgRow"     Color="#1B1F27"/>
        <SolidColorBrush x:Key="BgRowAlt"  Color="#20242E"/>
        <SolidColorBrush x:Key="Border"    Color="#2A2F3A"/>
        <SolidColorBrush x:Key="Fg"        Color="#E6E9EF"/>
        <SolidColorBrush x:Key="FgDim"     Color="#8A93A6"/>
        <SolidColorBrush x:Key="Accent"    Color="#4C8BF5"/>
        <SolidColorBrush x:Key="Good"      Color="#3FB950"/>
        <SolidColorBrush x:Key="Warn"      Color="#D29922"/>

    </Application.Resources>
</Application>
